* text=auto eol=lf

# Dart / Kotlin / Gradle: always LF
*.dart   text eol=lf
*.kt     text eol=lf
*.kts    text eol=lf
*.gradle text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf
*.sh     text eol=lf

# Windows launcher scripts must keep CRLF
*.bat    text eol=crlf

# Binary assets — never touch
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.ttf    binary
*.otf    binary
*.jar    binary
*.jks    binary
*.keystore binary

# Generated files: excluded from diffs and language stats
pubspec.lock        linguist-generated
android/gradle/wrapper/gradle-wrapper.jar binary
